---
import MainLayout from '../layouts/MainLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
// import BlogPreviewCard from '../components/BlogPreviewCard.astro';

const featuredProjects = [
	{
		title: 'Clip and Ship',
		description:
			'A Python script to automate the process of downloading, concatenating, minimally editing, and uploading Twitch clips to YouTube.',
		tags: ['Python', 'FFmpeg', 'Twitch API', 'YouTube API'],
		demoLink: 'https://youtu.be/yDiupoXFduM?si=OCPRQBSag14_cyGf',
		repoLink: 'https://github.com/ndavidson7/clip-and-ship',
	},
	{
		title: 'Symphony Scramble',
		description:
			"Music-oriented platformer developed as a group project for UVA's Computer Game Design course.",
		tags: ['C#', '.NET', 'MonoGame'],
		repoLink: 'https://github.com/ndavidson7/symphony-scramble',
	},
	{
		title: 'Ride-a-long',
		description:
			'Carpooling web app designed to connect road trip drivers with people looking for a ride.',
		tags: [
			'Laravel',
			'PHP',
			'Tailwind',
			'MySQL',
			'Docker',
			'JavaScript',
			'AlpineJS',
			'Livewire',
			'Vite',
			'WebSockets',
		],
		repoLink: 'https://github.com/ndavidson7/ride-a-long/tree/convert-to-tallstack',
	},
];

// const latestPosts = [];
---

<MainLayout>
	<section id="home" class="px-5 pt-28 pb-20 sm:pt-32 sm:pb-28">
		<div class="mx-auto max-w-5xl">
			<div data-reveal class="space-y-8">
				<h1
					class="max-w-3xl text-4xl font-semibold tracking-tight text-white sm:text-5xl md:text-6xl"
				>
					Hi, I'm Nicholas, an eager learner and occasional problem solver.
				</h1>
				<p class="max-w-2xl text-lg leading-8 text-slate-300">Something something</p>
				<div class="flex flex-wrap gap-4">
					<a
						href="#projects"
						class="inline-flex items-center justify-center rounded-full bg-cyan-500 px-6 py-3 text-sm font-semibold text-slate-950 transition hover:bg-cyan-400"
					>
						Featured work
					</a>
					<a
						href="#contact"
						class="inline-flex items-center justify-center rounded-full border border-slate-700 px-6 py-3 text-sm font-semibold text-slate-200 transition hover:border-cyan-300/60 hover:text-white"
					>
						Get in touch
					</a>
				</div>
			</div>
		</div>
	</section>

	<section id="about" class="border-t border-slate-800/80 px-5 py-20 sm:py-24">
		<div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[1.2fr_0.8fr] lg:items-start">
			<div data-reveal class="space-y-6">
				<p class="text-sm tracking-[0.35em] text-cyan-300/80 uppercase">About</p>
				<h2 class="text-3xl font-semibold text-white sm:text-4xl">
					Self-titled software generalist
				</h2>
				<p class="max-w-2xl text-base leading-8 text-slate-300">
					With an education in computer science and professional experience in software development,
					I have exposure to a wide variety of technologies and am always excited to pick up new
					skills and tools. To that end, I enjoy working on projects of all shapes and sizes and
					have a proven ability to quickly learn and contribute to new codebases and domains.
				</p>
			</div>

			<div
				data-reveal
				class="rounded-4xl border border-slate-800/80 bg-slate-950/70 p-8 shadow-xl shadow-slate-950/20"
			>
				<div class="space-y-6">
					<div>
						<p class="text-sm tracking-[0.35em] text-cyan-300/80 uppercase">Focus areas</p>
						<h3 class="mt-3 text-xl font-semibold text-white">My Expertise</h3>
					</div>
					<ul class="space-y-3 text-slate-300">
						<li>• C# and .NET</li>
						<li>• SQL</li>
						<li>• Python</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<section id="projects" class="border-t border-slate-800/80 px-5 py-20 sm:py-24">
		<div class="mx-auto max-w-6xl">
			<div data-reveal class="space-y-8">
				<div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
					<div>
						<p class="text-sm tracking-[0.35em] text-cyan-300/80 uppercase">Featured Projects</p>
						<h2 class="mt-3 text-3xl font-semibold text-white sm:text-4xl">
							Some examples of my work.
						</h2>
					</div>
					<!-- <a href="#projects" class="text-sm font-medium text-cyan-300 transition hover:text-white"
						>See more anchors →</a
					> -->
				</div>
				<div class="grid gap-6 lg:grid-cols-3">
					{featuredProjects.map((project) => <ProjectCard {...project} />)}
				</div>
			</div>
		</div>
	</section>

	<!-- <section id="blog" class="border-t border-slate-800/80 px-5 py-20 sm:py-24">
		<div class="mx-auto max-w-6xl">
			<div data-reveal class="space-y-8">
				<div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
					<div>
						<p class="text-sm tracking-[0.35em] text-cyan-300/80 uppercase">Latest Writing</p>
						<h2 class="mt-3 text-3xl font-semibold text-white sm:text-4xl">
							Short reads for projects and process.
						</h2>
					</div>
					<a href="#blog" class="text-sm font-medium text-cyan-300 transition hover:text-white"
						>Browse the blog →</a
					>
				</div>
				<div class="grid gap-6 lg:grid-cols-3">
					{latestPosts.map((post) => <BlogPreviewCard {...post} />)}
				</div>
			</div>
		</div>
	</section> -->

	<section id="contact" class="border-t border-slate-800/80 px-5 py-20 sm:py-24">
		<div class="mx-auto max-w-5xl">
			<div data-reveal>
				<div
					class="rounded-4xl border border-slate-800/80 bg-slate-950/70 p-10 shadow-2xl shadow-slate-950/20"
				>
					<div class="grid gap-8 lg:grid-cols-[1.3fr_0.7fr] lg:items-center">
						<div class="space-y-4">
							<p class="text-sm tracking-[0.35em] text-cyan-300/80 uppercase">Contact</p>
							<h2 class="text-3xl font-semibold text-white sm:text-4xl">
								Let's keep it simple and static.
							</h2>
							<p class="max-w-xl leading-8 text-slate-300">
								No backend needed. Reach out via email or connect on your preferred profile for
								fast, edge-friendly communication.
							</p>
						</div>
						<div class="space-y-4">
							<a
								href="mailto:hello@example.com"
								class="inline-flex w-full items-center justify-center rounded-full bg-cyan-500 px-6 py-3 text-sm font-semibold text-slate-950 transition hover:bg-cyan-400"
							>
								Say hello
							</a>
							<p class="text-sm text-slate-400">
								Or connect on <a class="text-cyan-300 hover:text-white" href="#">LinkedIn</a> / <a
									class="text-cyan-300 hover:text-white"
									href="#">GitHub</a
								>.
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</MainLayout>
