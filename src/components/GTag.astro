---
const isProduction = import.meta.env.PROD;
---

{
    isProduction && (
        <>
            <script is:inline type="text/partytown" async src="https://www.googletagmanager.com/gtag/js?id=G-3JJVME3832"></script>
            <script is:inline type="text/partytown">
                window.dataLayer = window.dataLayer || [];
                function gtag(...args) {
                    dataLayer.push(args);
                }
                gtag('js', new Date());
                gtag("consent", "default", {
                    ad_storage: "denied",
                    ad_user_data: "denied",
                    ad_personalization: "denied",
                    analytics_storage: "denied",
                });
                gtag('config', 'G-3JJVME3832');
            </script>
        </>
    )
}
