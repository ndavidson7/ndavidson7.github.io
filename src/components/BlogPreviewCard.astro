---
interface Props {
	title: string;
	excerpt: string;
	href?: string;
	date?: string;
}

const { title, excerpt, href = '#', date } = Astro.props as Props;
---

<article
	class="group rounded-4xl border border-slate-800/80 bg-slate-950/70 p-6 transition duration-300 hover:-translate-y-1 hover:border-cyan-400/40 hover:bg-slate-900/90"
>
	<div class="space-y-4">
		<div class="flex items-start justify-between gap-4">
			<h3 class="text-lg font-semibold text-white">{title}</h3>
			<span class="text-xs tracking-[0.2em] text-cyan-300/80 uppercase">{date}</span>
		</div>
		<p class="text-slate-300">{excerpt}</p>
	</div>
	<a
		href={href}
		class="mt-6 inline-block text-sm font-semibold text-cyan-300 transition hover:text-white"
	>
		Read post →
	</a>
</article>
