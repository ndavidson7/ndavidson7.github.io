{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "portfolio",
	"compatibility_date": "2026-06-03",
	"assets": {
		"directory": "./dist",
	},
	"env": {
		"staging": {
			"workers_dev": true,
		},
		"production": {
			"workers_dev": false,
			"route": {
				"pattern": "www.nicholasdavidson.dev",
				"custom_domain": true,
			},
		},
	},
}
